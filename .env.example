# ==============================================================================
# Finculator Application Environment Configuration (.env.example)
# Copy this file to '.env' and update placeholder values for your deployment.
# ==============================================================================

# Server Environment
PORT=3000
HOST=127.0.0.1
APP_ENV=development # Options: 'development', 'staging', 'production'
DEBUG=false

# Cryptographic Keys (MUST be rotated and kept secret in production)
# In production, SECRET_KEY must be a cryptographically random string (min 32 chars)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ADMIN_API_KEY=change-this-to-a-secure-random-admin-key-in-production

# Web Layer & Security Headers
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENFORCE_HTTPS=false
CSRF_PROTECTION_ENABLED=true

# Rate Limiting (per client IP)
AUTH_RATE_LIMIT_PER_MIN=10
API_RATE_LIMIT_PER_MIN=60

# External AI Spend Ceiling & Usage Guardrails
AI_DAILY_SPEND_CAP_USD=5.00
AI_DAILY_REQUEST_LIMIT=500
